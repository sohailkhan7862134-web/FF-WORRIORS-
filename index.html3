<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Biharideluxbhaiya Tournament</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <header>
    <div class="logo">Biharideluxbhaiya</div>
    <button onclick="showProfile()">Profile</button>
  </header>

  <main>

    <section id="loginPage" class="page">
      <div class="card login-card">
        <h1>🎮 Tournament Arena</h1>
        <p>Login to continue</p>

        <input id="mobile" type="tel" maxlength="10"
               placeholder="Enter mobile number">

        <button class="primary" onclick="sendOTP()">Send OTP</button>

        <div id="otpBox" style="display:none;">
          <input id="otp" type="number"
                 placeholder="Enter OTP">
          <button class="primary" onclick="verifyOTP()">Verify OTP</button>
        </div>
      </div>
    </section>


    <section id="homePage" class="page" style="display:none;">

      <div class="hero">
        <h1>🔥 Live Tournaments</h1>
        <p>Join • Play • Win</p>
      </div>

      <div id="tournamentList"></div>

    </section>


    <section id="paymentPage" class="page" style="display:none;">

      <div class="card">
        <h2>💳 Tournament Payment</h2>

        <h3 id="paymentTournament"></h3>

        <p>Entry Fee: ₹<span id="paymentFee"></span></p>

        <div class="qr-box">
          <img id="qrImage"
               src="https://placehold.co/300x300?text=YOUR+QR"
               alt="Payment QR">
        </div>

        <p class="upi">
          UPI: <b id="upiId">yourupi@upi</b>
        </p>

        <input type="file" id="paymentScreenshot"
               accept="image/*">

        <button class="primary" onclick="submitPayment()">
          Submit Payment
        </button>

        <button class="back" onclick="goHome()">← Back</button>

      </div>

    </section>


    <section id="profilePage" class="page" style="display:none;">

      <div class="card">
        <h2>👤 My Profile</h2>

        <p>Mobile: <b id="profileMobile"></b></p>

        <h3>🏆 Joined Tournaments</h3>

        <div id="history"></div>

        <button class="back" onclick="goHome()">← Back</button>
      </div>

    </section>

  </main>


  <nav id="bottomNav" style="display:none;">
    <button onclick="goHome()">🏠<span>Home</span></button>
    <button onclick="showProfile()">👤<span>Profile</span></button>
  </nav>


  <script src="app.js"></script>

</body>
</html>
